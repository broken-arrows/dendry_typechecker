{
  "name": "Dendry",
  "scopeName": "source.dendry",
  "patterns": [
    {
      "include": "#root-header"
    },
    {
      "include": "#section-header"
    },
    {
      "include": "#comments"
    },
    {
      "include": "#options"
    },
    {
      "include": "#qdisplay-range"
    },
    {
      "include": "#paragraph"
    }
  ],
  "repository": {
    "root-header": {
      "name": "meta.scene.header.dendry",
      "begin": "\\A(?=[ \\t]*(?:#|[A-Za-z][A-Za-z_ -]*[A-Za-z][ \\t]*:))",
      "end": "^(?=[ \\t]*$|@)",
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "include": "#properties"
        }
      ]
    },
    "section-header": {
      "name": "meta.scene.header.dendry",
      "begin": "^(@)[ \\t]*([\\w-]+(?:\\.[\\w-]+)*)[ \\t]*$",
      "end": "^(?=[ \\t]*$|@)",
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.scene.dendry"
        },
        "2": {
          "name": "meta.scene-reference.dendry",
          "patterns": [
            {
              "include": "#scene-reference"
            }
          ]
        }
      },
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "include": "#properties"
        }
      ]
    },
    "properties": {
      "patterns": [
        {
          "name": "meta.property.text.dendry",
          "begin": "^[ \\t]*((?i:title)|(?i:subtitle)|(?:[uU]navailableSubtitle|(?i:unavailable[_ -]+subtitle)))([ \\t]*:)[ \\t]*",
          "end": "(?=^[^ \\t]|^[ \\t]*$)",
          "beginCaptures": {
            "1": {
              "name": "variable.parameter.dendry"
            },
            "2": {
              "name": "punctuation.separator.key-value.dendry"
            }
          },
          "patterns": [
            {
              "include": "#value-text"
            }
          ]
        },
        {
          "name": "meta.property.logic.dendry",
          "begin": "^[ \\t]*((?:[vV]iewIf|(?i:view[_ -]+if))|(?:[cC]hooseIf|(?i:choose[_ -]+if))|(?:[fF]requencyVar|(?i:frequency[_ -]+var))|(?:[mM]axVisitsVar|(?i:max[_ -]+visits[_ -]+var))|(?:[oO]nArrival|(?i:on[_ -]+arrival))|(?:[oO]nDeparture|(?i:on[_ -]+departure))|(?:[oO]nDisplay|(?i:on[_ -]+display))|(?:[iI]sValid|(?i:is[_ -]+valid)))([ \\t]*:)[ \\t]*",
          "end": "(?=^[^ \\t]|^[ \\t]*$)",
          "beginCaptures": {
            "1": {
              "name": "variable.parameter.dendry"
            },
            "2": {
              "name": "punctuation.separator.key-value.dendry"
            }
          },
          "patterns": [
            {
              "include": "#value-logic"
            }
          ]
        },
        {
          "name": "meta.property.destination.dendry",
          "begin": "^[ \\t]*((?:[gG]oTo|(?i:go[_ -]+to))|(?:[gG]oSub|(?i:go[_ -]+sub))|(?:[gG]oSubStart|(?i:go[_ -]+sub[_ -]+start))|(?:[gG]oSubEnd|(?i:go[_ -]+sub[_ -]+end)))([ \\t]*:)[ \\t]*",
          "end": "(?=^[^ \\t]|^[ \\t]*$)",
          "beginCaptures": {
            "1": {
              "name": "variable.parameter.dendry"
            },
            "2": {
              "name": "punctuation.separator.key-value.dendry"
            }
          },
          "patterns": [
            {
              "include": "#value-destination"
            }
          ]
        },
        {
          "name": "meta.property.quality-destination.dendry",
          "begin": "^[ \\t]*((?:[gG]oToRef|(?i:go[_ -]+to[_ -]+ref)))([ \\t]*:)[ \\t]*",
          "end": "(?=^[^ \\t]|^[ \\t]*$)",
          "beginCaptures": {
            "1": {
              "name": "variable.parameter.dendry"
            },
            "2": {
              "name": "punctuation.separator.key-value.dendry"
            }
          },
          "patterns": [
            {
              "include": "#value-quality-destination"
            }
          ]
        },
        {
          "name": "meta.property.reference.dendry",
          "begin": "^[ \\t]*((?:[sS]etJump|(?i:set[_ -]+jump))|(?i:call)|(?:[cC]heckSuccessGoTo|(?i:check[_ -]+success[_ -]+go[_ -]+to))|(?:[cC]heckFailureGoTo|(?i:check[_ -]+failure[_ -]+go[_ -]+to))|(?:[fF]irstScene|(?i:first[_ -]+scene))|(?:[rR]ootScene|(?i:root[_ -]+scene)))([ \\t]*:)[ \\t]*",
          "end": "(?=^[^ \\t]|^[ \\t]*$)",
          "beginCaptures": {
            "1": {
              "name": "variable.parameter.dendry"
            },
            "2": {
              "name": "punctuation.separator.key-value.dendry"
            }
          },
          "patterns": [
            {
              "include": "#value-reference"
            }
          ]
        },
        {
          "name": "meta.property.quality-name.dendry",
          "begin": "^[ \\t]*((?:[cC]heckQuality|(?i:check[_ -]+quality))|(?:[dD]efaultDisplay|(?i:default[_ -]+display)))([ \\t]*:)[ \\t]*",
          "end": "(?=^[^ \\t]|^[ \\t]*$)",
          "beginCaptures": {
            "1": {
              "name": "variable.parameter.dendry"
            },
            "2": {
              "name": "punctuation.separator.key-value.dendry"
            }
          },
          "patterns": [
            {
              "include": "#value-quality-name"
            }
          ]
        },
        {
          "name": "meta.property.scalar.dendry",
          "begin": "^[ \\t]*((?i:order)|(?i:priority)|(?i:frequency)|(?i:signal)|(?i:style)|(?i:tags)|(?:[mM]axVisits|(?i:max[_ -]+visits))|(?:[cC]ountVisitsMax|(?i:count[_ -]+visits[_ -]+max))|(?:[gG]ameOver|(?i:game[_ -]+over))|(?:[nN]ewPage|(?i:new[_ -]+page))|(?:[sS]etRoot|(?i:set[_ -]+root))|(?:[iI]sTop|(?i:is[_ -]+top))|(?:[iI]sSpecial|(?i:is[_ -]+special))|(?:[iI]sDeck|(?i:is[_ -]+deck))|(?:[iI]sPinnedCard|(?i:is[_ -]+pinned[_ -]+card))|(?:[iI]sCard|(?i:is[_ -]+card))|(?:[iI]sHand|(?i:is[_ -]+hand))|(?:[mM]inChoices|(?i:min[_ -]+choices))|(?:[mM]axChoices|(?i:max[_ -]+choices))|(?:[mM]axCards|(?i:max[_ -]+cards))|(?:[sS]etBg|(?i:set[_ -]+bg))|(?:[sS]etMusic|(?i:set[_ -]+music))|(?:[sS]etSprites|(?i:set[_ -]+sprites))|(?:[sS]etSpriteStyles|(?i:set[_ -]+sprite[_ -]+styles))|(?:[sS]etTopLeftStyle|(?i:set[_ -]+top[_ -]+left[_ -]+style))|(?:[sS]etTopRightStyle|(?i:set[_ -]+top[_ -]+right[_ -]+style))|(?:[sS]etBottomLeftStyle|(?i:set[_ -]+bottom[_ -]+left[_ -]+style))|(?:[sS]etBottomRightStyle|(?i:set[_ -]+bottom[_ -]+right[_ -]+style))|(?i:achievement)|(?i:audio)|(?:[cC]ardImage|(?i:card[_ -]+image))|(?:[fF]aceImage|(?i:face[_ -]+image))|(?:[bB]roadDifficulty|(?i:broad[_ -]+difficulty))|(?:[nN]arrowDifficulty|(?i:narrow[_ -]+difficulty))|(?:[dD]ifficultyScaler|(?i:difficulty[_ -]+scaler))|(?:[dD]ifficultyIncrement|(?i:difficulty[_ -]+increment))|(?i:name)|(?i:initial)|(?i:min)|(?i:max)|(?i:type)|(?i:author)|(?i:ifid)|(?i:animate)|(?:[sS]ceneSignal|(?i:scene[_ -]+signal))|(?:[qQ]ualitySignal|(?i:quality[_ -]+signal))|(?:[dD]isplaySidebar|(?i:display[_ -]+sidebar))|(?:[dD]isplayStats|(?i:display[_ -]+stats))|(?:[dD]isplayOptions|(?i:display[_ -]+options))|(?:[sS]idebarStats|(?i:sidebar[_ -]+stats)))([ \\t]*:)[ \\t]*",
          "end": "(?=^[^ \\t]|^[ \\t]*$)",
          "beginCaptures": {
            "1": {
              "name": "variable.parameter.dendry"
            },
            "2": {
              "name": "punctuation.separator.key-value.dendry"
            }
          },
          "patterns": [
            {
              "include": "#value-scalar"
            }
          ]
        }
      ]
    },
    "options": {
      "name": "meta.options.dendry",
      "begin": "^(?=-[ \\t]*[@#])",
      "end": "^(?=[ \\t]*$|@)",
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "name": "meta.property.text.dendry",
          "begin": "^(-)[ \\t]*((?i:title)|(?i:subtitle)|(?:[uU]navailableSubtitle|(?i:unavailable[_ -]+subtitle)))([ \\t]*:)[ \\t]*",
          "end": "(?=^[^ \\t]|^[ \\t]*$)",
          "beginCaptures": {
            "1": {
              "name": "punctuation.definition.choice.dendry"
            },
            "2": {
              "name": "variable.parameter.dendry"
            },
            "3": {
              "name": "punctuation.separator.key-value.dendry"
            }
          },
          "patterns": [
            {
              "include": "#value-text"
            }
          ]
        },
        {
          "name": "meta.property.logic.dendry",
          "begin": "^(-)[ \\t]*((?:[vV]iewIf|(?i:view[_ -]+if))|(?:[cC]hooseIf|(?i:choose[_ -]+if))|(?:[fF]requencyVar|(?i:frequency[_ -]+var)))([ \\t]*:)[ \\t]*",
          "end": "(?=^[^ \\t]|^[ \\t]*$)",
          "beginCaptures": {
            "1": {
              "name": "punctuation.definition.choice.dendry"
            },
            "2": {
              "name": "variable.parameter.dendry"
            },
            "3": {
              "name": "punctuation.separator.key-value.dendry"
            }
          },
          "patterns": [
            {
              "include": "#value-logic"
            }
          ]
        },
        {
          "name": "meta.property.scalar.dendry",
          "begin": "^(-)[ \\t]*((?i:order)|(?i:priority)|(?i:frequency))([ \\t]*:)[ \\t]*",
          "end": "(?=^[^ \\t]|^[ \\t]*$)",
          "beginCaptures": {
            "1": {
              "name": "punctuation.definition.choice.dendry"
            },
            "2": {
              "name": "variable.parameter.dendry"
            },
            "3": {
              "name": "punctuation.separator.key-value.dendry"
            }
          },
          "patterns": [
            {
              "include": "#value-scalar"
            }
          ]
        },
        {
          "name": "meta.choice.dendry",
          "begin": "^(-)[ \\t]*(?:(@)((?:\\.+|[\\w-])[\\w-]*(?:\\.[\\w-]+)*)|(#)([\\w-]+))[ \\t]*(?=:|$)",
          "end": "(?=^[^ \\t]|^[ \\t]*$)",
          "beginCaptures": {
            "1": {
              "name": "punctuation.definition.choice.dendry"
            },
            "2": {
              "name": "punctuation.definition.scene-reference.dendry"
            },
            "3": {
              "name": "meta.scene-reference.dendry",
              "patterns": [
                {
                  "include": "#scene-reference"
                }
              ]
            },
            "4": {
              "name": "punctuation.definition.tag.dendry"
            },
            "5": {
              "name": "entity.name.tag.dendry"
            }
          },
          "patterns": [
            {
              "name": "punctuation.separator.key-value.dendry",
              "match": "\\G[ \\t]*:"
            },
            {
              "include": "#rich-content"
            }
          ]
        }
      ]
    },
    "value-text": {
      "patterns": [
        {
          "include": "#rich-content"
        }
      ]
    },
    "value-logic": {
      "patterns": [
        {
          "include": "#js-block"
        },
        {
          "include": "#logic"
        }
      ]
    },
    "value-reference": {
      "patterns": [
        {
          "include": "#scene-reference"
        }
      ]
    },
    "scene-reference": {
      "patterns": [
        {
          "name": "meta.qualified-scene-ref.dendry",
          "match": "(@?)((?:\\.+)?[\\w-]+(?:\\.[\\w-]+)*)(\\.)([\\w-]+)",
          "captures": {
            "1": {
              "name": "punctuation.definition.scene-reference.dendry"
            },
            "2": {
              "name": "entity.name.type.dendry"
            },
            "3": {
              "name": "punctuation.accessor.dendry"
            },
            "4": {
              "name": "entity.name.function.dendry"
            }
          }
        },
        {
          "name": "entity.name.function.dendry",
          "match": "@?(?:\\.+|[\\w-])[\\w-]*(?:\\.[\\w-]+)*"
        }
      ]
    },
    "value-quality-name": {
      "patterns": [
        {
          "name": "variable.other.dendry",
          "match": "[A-Za-z][-A-Za-z0-9_]*"
        }
      ]
    },
    "value-scalar": {
      "patterns": [
        {
          "name": "constant.language.dendry",
          "match": "(?i:(?<![\\w-])(?:yes|true|t|y|ok|no|false|f|n)(?![\\w-]))"
        },
        {
          "include": "#number"
        }
      ]
    },
    "value-destination": {
      "patterns": [
        {
          "name": "meta.destination.clause.dendry",
          "begin": "(@?)((?:\\.+|[\\w-])[\\w-]*(?:\\.[\\w-]+)*)(?=\\s|;|$)",
          "end": "(?=;|^[^ \\t]|^[ \\t]*$)",
          "beginCaptures": {
            "1": {
              "name": "punctuation.definition.scene-reference.dendry"
            },
            "2": {
              "name": "meta.scene-reference.dendry",
              "patterns": [
                {
                  "include": "#scene-reference"
                }
              ]
            }
          },
          "patterns": [
            {
              "include": "#destination-predicate"
            }
          ]
        },
        {
          "name": "punctuation.separator.dendry",
          "match": ";"
        }
      ]
    },
    "value-quality-destination": {
      "patterns": [
        {
          "name": "meta.destination.clause.dendry",
          "begin": "[A-Za-z][-A-Za-z0-9_]*(?=\\s|;|$)",
          "end": "(?=;|^[^ \\t]|^[ \\t]*$)",
          "beginCaptures": {
            "0": {
              "name": "variable.other.dendry"
            }
          },
          "patterns": [
            {
              "include": "#destination-predicate"
            }
          ]
        },
        {
          "name": "punctuation.separator.dendry",
          "match": ";"
        }
      ]
    },
    "destination-predicate": {
      "name": "meta.predicate.dendry",
      "begin": "(?<!\\S)(if)(?=\\s)",
      "end": "(?=;|^[^ \\t]|^[ \\t]*$)",
      "beginCaptures": {
        "1": {
          "name": "keyword.control.dendry"
        }
      },
      "patterns": [
        {
          "include": "#js-block"
        },
        {
          "include": "#logic"
        }
      ]
    },
    "logic": {
      "patterns": [
        {
          "name": "string.quoted.double.dendry",
          "begin": "\"",
          "end": "\""
        },
        {
          "name": "string.quoted.single.dendry",
          "begin": "'",
          "end": "'"
        },
        {
          "name": "variable.other.scene-visits.dendry",
          "match": "(@)([\\w-]+(?:\\.[\\w-]+)+)",
          "captures": {
            "1": {
              "name": "punctuation.definition.scene-reference.dendry"
            },
            "2": {
              "name": "meta.scene-reference.dendry",
              "patterns": [
                {
                  "include": "#scene-reference"
                }
              ]
            }
          }
        },
        {
          "name": "variable.other.scene-visits.dendry",
          "match": "@[\\w-]+(?:\\.[\\w-]+)*"
        },
        {
          "name": "keyword.operator.logical.dendry",
          "match": "(?<![\\w-])(?:and|AND|or|OR|not|NOT)(?![\\w-])"
        },
        {
          "name": "constant.language.dendry",
          "match": "(?<![\\w-])(?:true|TRUE|false|FALSE)(?![\\w-])"
        },
        {
          "name": "keyword.control.dendry",
          "match": "(?<![\\w-])(?:if|then|else)(?![\\w-])"
        },
        {
          "name": "entity.name.function.dendry",
          "match": "[A-Za-z][-A-Za-z0-9_]*(?=[ \\t]*\\()"
        },
        {
          "name": "variable.other.dendry",
          "match": "[A-Za-z][-A-Za-z0-9_]*"
        },
        {
          "include": "#number"
        },
        {
          "name": "keyword.operator.assignment.dendry",
          "match": "(?:[+*/-]=|=(?!=))"
        },
        {
          "name": "keyword.operator.comparison.dendry",
          "match": "(?:<=|>=|!=|==|<|>)"
        },
        {
          "name": "keyword.operator.arithmetic.dendry",
          "match": "[+*/%\\-]"
        },
        {
          "name": "punctuation.separator.dendry",
          "match": "[,;.]"
        },
        {
          "name": "punctuation.section.group.dendry",
          "match": "[()\\[\\]]"
        }
      ]
    },
    "number": {
      "name": "constant.numeric.dendry",
      "match": "(?<![\\w.])-?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?![\\w.])"
    },
    "js-block": {
      "patterns": [
        {
          "name": "meta.logic.javascript.dendry",
          "match": "(\\{!)(.*?)(!\\})",
          "captures": {
            "1": {
              "name": "punctuation.section.embedded.begin.dendry"
            },
            "2": {
              "name": "meta.embedded.block.javascript.dendry",
              "patterns": [
                {
                  "include": "source.dendry.javascript"
                }
              ]
            },
            "3": {
              "name": "punctuation.section.embedded.end.dendry"
            }
          }
        },
        {
          "name": "meta.logic.javascript.dendry",
          "contentName": "meta.embedded.block.javascript.dendry",
          "begin": "\\{!",
          "end": "!\\}",
          "beginCaptures": {
            "0": {
              "name": "punctuation.section.embedded.begin.dendry"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.section.embedded.end.dendry"
            }
          },
          "patterns": [
            {
              "include": "source.dendry.javascript"
            }
          ]
        }
      ]
    },
    "html-block": {
      "name": "meta.content.html.dendry",
      "contentName": "meta.embedded.block.html.dendry",
      "begin": "(?<!\\\\)\\{!",
      "end": "(?<!\\\\)!\\}",
      "beginCaptures": {
        "0": {
          "name": "punctuation.section.embedded.begin.dendry"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.section.embedded.end.dendry"
        }
      },
      "patterns": [
        {
          "include": "text.html.basic"
        }
      ]
    },
    "paragraph": {
      "name": "meta.paragraph.dendry",
      "begin": "^(?!@)(?=[ \\t]*\\S)",
      "end": "^(?=[ \\t]*$|@)",
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "include": "#paragraph-markup"
        },
        {
          "include": "#rich-content"
        }
      ]
    },
    "rich-content": {
      "patterns": [
        {
          "include": "#escape"
        },
        {
          "include": "#variable-interpolation"
        },
        {
          "include": "#inline-conditional"
        },
        {
          "include": "#html-block"
        },
        {
          "include": "#inline-html"
        },
        {
          "include": "#html-entity"
        },
        {
          "include": "#emphasis"
        },
        {
          "include": "#hidden"
        },
        {
          "name": "punctuation.definition.line-break.dendry",
          "match": "(?<!\\\\)//$"
        }
      ]
    },
    "escape": {
      "name": "constant.character.escape.dendry",
      "match": "\\\\(?=[*`\\[\\]{}?+!/=<>])"
    },
    "html-entity": {
      "name": "constant.character.entity.html",
      "match": "(?<!\\\\)&(?:[A-Za-z][A-Za-z0-9]*|#[0-9]+|#[xX][0-9A-Fa-f]+);"
    },
    "inline-html": {
      "patterns": [
        {
          "name": "comment.block.html",
          "begin": "(?<!\\\\)<!--",
          "end": "-->",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.begin.html"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.comment.end.html"
            }
          }
        },
        {
          "name": "meta.tag.inline.html.dendry",
          "begin": "(?<!\\\\)(</?)([A-Za-z][A-Za-z0-9:_-]*)(?=[\\s/>])",
          "end": "/?>",
          "beginCaptures": {
            "1": {
              "name": "punctuation.definition.tag.begin.html"
            },
            "2": {
              "name": "entity.name.tag.html"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.tag.end.html"
            }
          },
          "patterns": [
            {
              "name": "entity.other.attribute-name.html",
              "match": "[A-Za-z_:][\\w:.-]*"
            },
            {
              "name": "meta.attribute.value.html",
              "begin": "(=)\\s*",
              "end": "(?=\\s|/?>)",
              "beginCaptures": {
                "1": {
                  "name": "keyword.operator.assignment.html"
                }
              },
              "patterns": [
                {
                  "name": "string.quoted.double.html",
                  "begin": "\"",
                  "end": "\"",
                  "patterns": [
                    {
                      "include": "#variable-interpolation"
                    },
                    {
                      "include": "#inline-conditional"
                    },
                    {
                      "include": "#html-entity"
                    }
                  ]
                },
                {
                  "name": "string.quoted.single.html",
                  "begin": "'",
                  "end": "'",
                  "patterns": [
                    {
                      "include": "#variable-interpolation"
                    },
                    {
                      "include": "#inline-conditional"
                    },
                    {
                      "include": "#html-entity"
                    }
                  ]
                },
                {
                  "include": "#variable-interpolation"
                },
                {
                  "include": "#inline-conditional"
                },
                {
                  "include": "#html-entity"
                },
                {
                  "name": "string.unquoted.html",
                  "match": "(?:/(?!>)|[^\\s<>\"'=`/])+"
                }
              ]
            }
          ]
