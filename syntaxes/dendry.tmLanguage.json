{
  "name": "Dendry",
  "scopeName": "source.dendry",
  "patterns": [
    {
      "name": "meta.inline-conditional.dendry",
      "begin": "(\\[\\?)",
      "end": "(\\?\\])",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.conditional.dendry" }
      },
      "endCaptures": {
        "1": { "name": "punctuation.definition.conditional.dendry" }
      },
      "patterns": [
        {
          "name": "meta.conditional-text.dendry",
          "begin": "\\s*:\\s*",
          "end": "(?=\\?\\])",
          "beginCaptures": {
            "0": { "name": "keyword.operator.conditional.separator.dendry" }
          },
          "patterns": [
            {
              "include": "#html-tags"
            },
            {
              "include": "#markdown-formatting"
            }
          ]
        },
        {
          "include": "#dendry-logic"
        }
      ]
    },
    {
      "name": "markup.heading.title.dendry",
      "match": "^\\s*(=+)\\s*(.+)$",
      "captures": {
        "1": { "name": "punctuation.definition.heading.dendry" },
        "2": { "name": "entity.name.section.dendry" }
      }
    },
    {
      "include": "#scene-id-declaration"
    },
    {
      "include": "#js-property"
    },
    {
      "include": "#comments"
    },
    {
      "include": "#scene-declaration"
    },
    {
      "include": "#quality-declaration"
    },
    {
      "include": "#choice"
    },
    {
      "include": "#go-to-property"
    },
    {
      "include": "#dendry-logic-property"
    },
    {
      "include": "#html-tags"
    },
    {
      "include": "#markdown-formatting"
    },
    {
      "include": "#property"
    }
  ],
  "repository": {
    "inline-conditional": {
      "name": "meta.inline-conditional.dendry",
      "begin": "(\\[\\?)",
      "end": "(\\?\\])",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.conditional.dendry" }
      },
      "endCaptures": {
        "1": { "name": "punctuation.definition.conditional.dendry" }
      },
      "patterns": [
        {
          "name": "meta.conditional-text.dendry",
          "begin": "\\s*:\\s*",
          "end": "(?=\\?\\])",
          "beginCaptures": {
            "0": { "name": "keyword.operator.conditional.separator.dendry" }
          },
          "patterns": [
            {
              "include": "#inline-conditional"
            },
            {
              "include": "#html-tags"
            },
            {
              "include": "#markdown-formatting"
            }
          ]
        },
        {
          "include": "#dendry-logic"
        }
      ]
    },
    "dendry-logic": {
      "patterns": [
        {
          "name": "variable.language.dendry",
          "match": "\\b(Q|S|V|P)\\."
        },
        {
          "name": "keyword.operator.logical.dendry",
          "match": "\\b(and|or|not)\\b"
        },
        {
          "name": "keyword.control.dendry",
          "match": "\\b(if|else|return|function)\\b"
        },
        {
          "name": "constant.language.dendry",
          "match": "\\b(true|false|null|undefined)\\b"
        },
        {
          "name": "keyword.operator.comparison.dendry",
          "match": "(===?|!==?|<=?|>=?)"
        },
        {
          "name": "keyword.operator.arithmetic.dendry",
          "match": "(\\+|\\-|\\*|\\/|%)"
        },
        {
          "name": "keyword.operator.assignment.dendry",
          "match": "(=|\\+=|\\-=|\\*=|\\/=)"
        },
        {
          "name": "constant.numeric.dendry",
          "match": "\\b\\d+(\\.\\d+)?\\b"
        },
        {
          "name": "string.quoted.single.dendry",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.dendry",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.double.dendry",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.dendry",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "variable.other.dendry",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
        }
      ]
    },
    "dendry-logic-property": {
      "name": "meta.property.dendry-logic.dendry",
      "begin": "^\\s*(view-if|choose-if|on-arrival|on-display|on-departure|on-choose):\\s+(?!\\{!)",
      "end": "$",
      "beginCaptures": {
        "1": { "name": "variable.parameter.dendry" }
      },
      "patterns": [
        {
          "include": "#dendry-logic"
        }
      ]
    },
    "go-to-property": {
      "name": "meta.property.go-to.dendry",
      "begin": "^\\s*(go-to|set-jump):\\s+",
      "end": "$",
      "beginCaptures": {
        "1": { "name": "variable.parameter.dendry" }
      },
      "patterns": [
        {
          "name": "meta.qualified-scene-ref.dendry",
          "match": "([a-zA-Z0-9_][\\w-]*)\\.([a-zA-Z0-9_][\\w-]*)",
          "captures": {
            "1": { "name": "entity.name.type.dendry" },
            "2": { "name": "entity.name.function.dendry" }
          }
        },
        {
          "name": "entity.name.function.dendry",
          "match": "[a-zA-Z0-9_][\\w-]*(?=\\s+if|\\s*;|\\s*$)"
        },
        {
          "name": "keyword.control.dendry",
          "match": "\\b(if)\\b"
        },
        {
          "name": "punctuation.separator.dendry",
          "match": ";"
        },
        {
          "include": "#dendry-logic"
        }
      ]
    },
    "scene-id-declaration": {
      "match": "^(@)([a-zA-Z0-9_][a-zA-Z0-9_-]*)(?=\\s|:|$)",
      "captures": {
        "1": { "name": "keyword.operator.dendry" },
        "2": { "name": "entity.name.function.dendry" }
      }
    },
    "js-property": {
      "name": "meta.property.js.dendry",
      "begin": "(^\\s*(?:id|title|subtitle|tags|order|frequency|max-visits|min-choices|max-choices|new-page|signal|content|on-arrival|on-display|on-departure|view-if|choose-if|priority|unavailable-subtitle|name|initial|min|max|on-choose|go-to|set-jump|is-special|set-bg|audio|is-hand|card-image|face-image|is-deck|max-cards|is-pinned-card|is-card)):\\s*(\\{!)",
      "end": "(!\\})",
      "beginCaptures": {
        "1": { "name": "variable.parameter.dendry" },
        "2": { "name": "punctuation.section.embedded.begin.dendry" }
      },
      "endCaptures": {
        "1": { "name": "punctuation.section.embedded.end.dendry" }
      },
      "patterns": [
        {
          "include": "source.js"
        }
      ]
    },
    "js-block": {
      "name": "meta.embedded.block.javascript.dendry",
      "begin": "\\{!\\s*",
      "end": "\\s*!\\}",
      "patterns": [
        {
          "include": "source.js"
        }
      ]
    },
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.dendry",
          "match": "^\\s*#(?![a-zA-Z_]).*$"
        }
      ]
    },
    "scene-declaration": {
      "match": "^(@)(scene|root)\\s+([a-zA-Z0-9_][a-zA-Z0-9_-]*)$",
      "captures": {
        "1": { "name": "keyword.operator.dendry" },
        "2": { "name": "keyword.control.dendry" },
        "3": { "name": "entity.name.function.dendry" }
      }
    },
    "quality-declaration": {
      "match": "^(@)(quality)\\s+([a-zA-Z0-9_]+)?$",
      "captures": {
        "1": { "name": "keyword.operator.dendry" },
        "2": { "name": "keyword.control.dendry" },
        "3": { "name": "entity.name.type.dendry" }
      }
    },
    "property": {
      "match": "^\\s*(id|title|subtitle|tags|order|frequency|max-visits|min-choices|max-choices|new-page|signal|content|on-arrival|on-display|on-departure|view-if|choose-if|priority|unavailable-subtitle|name|initial|min|max|on-choose|go-to|set-jump|is-special|set-bg|audio|is-hand|card-image|face-image|is-deck|max-cards|is-pinned-card|is-card):\\s*(.+)$",
      "captures": {
        "1": { "name": "variable.parameter.dendry" },
        "2": { "name": "string.unquoted.dendry" }
      }
    },
    "choice": {
      "patterns": [
        {
          "name": "meta.choice.tag.dendry",
          "match": "^\\s*(-|\\*)\\s+(#)([a-zA-Z0-9_][a-zA-Z0-9_-]*)\\s*$",
          "captures": {
            "1": { "name": "keyword.operator.dendry" },
            "2": { "name": "keyword.operator.dendry" },
            "3": { "name": "entity.name.tag.dendry" }
          }
        },
        {
          "name": "meta.choice.scene-ref.qualified.dendry",
          "match": "(-)\\s*(\\@)([a-zA-Z0-9_][\\w-]*)\\.([a-zA-Z0-9_][\\w-]*)(\\:)?\\s*(.*)?",
          "captures": {
            "1": { "name": "keyword.operator.dendry" },
            "2": { "name": "keyword.operator.dendry" },
            "3": { "name": "entity.name.type.dendry" },
            "4": { "name": "entity.name.function.dendry" },
            "5": { "name": "punctuation.separator.dendry" },
            "6": { "name": "string.unquoted.dendry" }
          }
        },
        {
          "name": "meta.choice.scene-ref.dendry",
          "match": "(-)\\s*(\\@)([a-zA-Z0-9_][\\w-]*)(\\:)?\\s*(.*)?",
          "captures": {
            "1": { "name": "keyword.operator.dendry" },
            "2": { "name": "keyword.operator.dendry" },
            "3": { "name": "entity.name.function.dendry" },
            "4": { "name": "punctuation.separator.dendry" },
            "5": { "name": "string.unquoted.dendry" }
          }
        },
        {
          "name": "meta.choice.conditional.dendry",
          "match": "^\\s*(-|\\*)\\s+(.+?)\\s+(if)\\s+(.+)$",
          "captures": {
            "1": { "name": "keyword.operator.dendry" },
            "2": { "name": "string.unquoted.dendry" },
            "3": { "name": "keyword.control.dendry" },
            "4": { "name": "meta.embedded.inline.dendry" }
          }
        },
        {
          "name": "meta.choice.text.dendry",
          "match": "^\\s*(-|\\*)\\s+(.+)$",
          "captures": {
            "1": { "name": "keyword.operator.dendry" },
            "2": { "name": "string.unquoted.dendry" }
          }
        }
      ]
    },
    "html-tags": {
      "patterns": [
        {
          "name": "meta.tag.html.dendry",
          "begin": "(<)([a-zA-Z][a-zA-Z0-9]*)",
          "end": "(>)",
          "beginCaptures": {
            "1": { "name": "punctuation.definition.tag.begin.html" },
            "2": { "name": "entity.name.tag.html" }
          },
          "endCaptures": {
            "1": { "name": "punctuation.definition.tag.end.html" }
          },
          "patterns": [
            {
              "name": "entity.other.attribute-name.html",
              "match": "\\b[a-zA-Z-]+(?=\\s*=)"
            },
            {
              "name": "string.quoted.double.html",
              "begin": "\"",
              "end": "\""
            },
            {
              "name": "string.quoted.single.html",
              "begin": "'",
              "end": "'"
            }
          ]
        },
        {
          "name": "meta.tag.html.closing.dendry",
          "match": "(</)([a-zA-Z][a-zA-Z0-9]*)(>)",
          "captures": {
            "1": { "name": "punctuation.definition.tag.begin.html" },
            "2": { "name": "entity.name.tag.html" },
            "3": { "name": "punctuation.definition.tag.end.html" }
          }
        }
      ]
    },
    "markdown-formatting": {
      "patterns": [
        {
          "name": "markup.bold.dendry",
          "match": "(\\*\\*)([^*]+)(\\*\\*)",
          "captures": {
            "1": { "name": "punctuation.definition.bold.dendry" },
            "2": { "name": "markup.bold.dendry" },
            "3": { "name": "punctuation.definition.bold.dendry" }
          }
        },
        {
          "name": "markup.italic.dendry",
          "match": "(\\*)([^*]+)(\\*)",
          "captures": {
            "1": { "name": "punctuation.definition.italic.dendry" },
            "2": { "name": "markup.italic.dendry" },
            "3": { "name": "punctuation.definition.italic.dendry" }
          }
        }
      ]
    }
  }
}
