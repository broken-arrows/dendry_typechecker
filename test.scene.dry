title: Example scene
set-bg: example_background.png
new-page: true
on-arrival: {!
  console.log("Arrived at example scene");
  asfasf; //this should flag an error (it does not)
  if (true) { 
    console.log("This is valid JS code");
  }
  Q.yes = true;
  iff () { // this should DEFINITELY flag an error (it does not)
  }
  if (Q.yes = 1) { // this should flag an error (it does not)
    Q.result = "yes";
  } else if (Q.no == true) {
    Q.result = "no";
  }
!}

Where do you want to go?

[? if yes = 1 or no = 1: some extra text ?]
# this should not flag an error!


# back is valid, even if it does not have ": something" after. In that case, the scene title will be displayed
