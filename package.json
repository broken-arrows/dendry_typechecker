{
  "name": "dendry-typechecker",
  "displayName": "Dendry Type Checker",
  "description": "Type checking and validation for Dendry interactive fiction files",
  "publisher": "BrokenArrow",
  "version": "0.1.0",
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.80.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/broken-arrows/dendry_typechecker.git"
  },
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:dendry",
    "workspaceContains:**/*.scene.dry",
    "workspaceContains:**/*.qdisplay.dry",
    "onStartupFinished"
  ],
  "contributes": {
    "languages": [
      {
        "id": "dendry",
        "aliases": [
          "Dendry",
          "dendry"
        ],
        "extensions": [
          ".scene.dry",
          ".qdisplay.dry"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "dendry",
        "scopeName": "source.dendry",
        "path": "./syntaxes/dendry.tmLanguage.json"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "Dendry Type Checker",
      "properties": {
        "dendry.validation.enable": {
          "type": "boolean",
          "default": true,
          "description": "Enable/disable validation"
        },
        "dendry.validation.exclude": {
          "type": "array",
          "default": [
            "**/node_modules/**",
            "**/.git/**",
            "**/dist/**",
            "**/build/**",
            "**/out/**"
          ],
          "items": {
            "type": "string"
          },
          "description": "Global patterns for files/folders to exclude from Dendry validation"
        },
        "dendry.validation.jsLibraries": {
          "type": "array",
          "default": [
            "d3"
          ],
          "items": {
            "type": "string"
          },
          "description": "A list of global JavaScript libraries to assume are available during validation."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/esprima": "^4.0.2",
    "@types/esprima-walk": "^0.1.2",
    "@types/node": "^16.0.0",
    "@types/vscode": "^1.80.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "esprima": "^4.0.1",
    "esprima-walk": "^0.1.0"
  }
}
