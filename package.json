{
  "name": "dendry-typechecker",
  "displayName": "DendryNexus",
  "description": "Type checking and validation for DendryNexus interactive fiction files",
  "publisher": "BrokenArrow",
  "version": "1.1.0",
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.80.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/broken-arrows/dendry_typechecker.git"
  },
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "main": "./dist/desktop/extension.js",
  "browser": "./dist/web/extension.js",
  "activationEvents": [
    "onLanguage:dendry",
    "onDebugResolve:dendry",
    "workspaceContains:**/*.scene.dry",
    "workspaceContains:**/*.quality.dry",
    "workspaceContains:**/info.dry",
    "workspaceContains:**/*.qdisplay.dry",
    "onStartupFinished"
  ],
  "contributes": {
    "languages": [
      {
        "id": "dendry",
        "aliases": [
          "DendryNexus",
          "dendrynexus",
          "dendry-nexus",
          "Dendry",
          "dry"
        ],
        "extensions": [
          ".scene.dry",
          ".quality.dry",
          ".qdisplay.dry"
        ],
        "filenames": [
          "info.dry"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "dendry",
        "scopeName": "source.dendry",
        "path": "./syntaxes/dendry.tmLanguage.json",
        "embeddedLanguages": {
          "meta.embedded.block.javascript.dendry": "javascript",
          "meta.embedded.block.html.dendry": "html"
        }
      },
      {
        "scopeName": "source.dendry.javascript",
        "path": "./syntaxes/dendry-javascript.tmLanguage.json"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "Dendry",
      "properties": {
        "dendry.validation.enable": {
          "scope": "resource",
          "type": "boolean",
          "default": true,
          "description": "Enable/disable validation"
        },
        "dendry.validation.strict": {
          "scope": "resource",
          "type": "boolean",
          "default": false,
          "description": "Enable/disable strict validation mode"
        },
        "dendry.validation.dendrynexusTen": {
          "scope": "resource",
          "type": "boolean",
          "default": false,
          "description": "Validate against DendryNexus TEN, including roles, choice images, game versions and languages. Disabled uses standard DendryNexus validation."
        },
        "dendry.validation.exclude": {
          "scope": "resource",
          "type": "array",
          "default": [
            "**/node_modules/**",
            "**/.git/**",
            "**/dist/**",
            "**/build/**",
            "**/out/**"
          ],
          "items": {
            "type": "string"
          },
          "description": "Glob patterns for files/folders to exclude from Dendry validation"
        },
        "dendry.validation.jsLibraries": {
          "scope": "resource",
          "type": "array",
          "default": [
            "d3"
          ],
          "items": {
            "type": "string"
          },
          "description": "A list of global JavaScript libraries to assume are available during validation."
        },
        "dendry.debug.buildCommand": {
          "scope": "resource",
          "type": "string",
          "default": "dendrynexus make-html --pretty",
          "description": "Shell command to build the Dendry project. Project and workspace node_modules/.bin directories are added to PATH."
        },
        "dendry.debug.outputPath": {
          "scope": "resource",
          "type": "string",
          "default": "out/html/index.html",
          "description": "HTML output path, absolute or relative to the build folder"
        }
      }
    },
    "debuggers": [
      {
        "type": "dendry",
        "label": "Dendry: Build and Launch",
        "languages": [
          "dendry"
        ],
        "configurationAttributes": {
          "launch": {
            "properties": {
              "buildCommand": {
                "type": "string",
                "minLength": 1,
                "description": "Shell build command; defaults to this project's dendry.debug.buildCommand setting."
              },
              "outputPath": {
                "type": "string",
                "minLength": 1,
                "description": "HTML output path, absolute or relative to the build folder."
              },
              "cwd": {
                "type": "string",
                "minLength": 1,
                "description": "Build folder, absolute or relative to the launch workspace folder. Defaults to the nearest project with source/info.dry."
              }
            }
          }
        },
        "configurationSnippets": [
          {
            "label": "Dendry: Launch",
            "description": "Build and launch Dendry project",
            "body": {
              "type": "dendry",
              "request": "launch",
              "name": "Build and Launch Dendry"
            }
          }
        ]
      }
    ],
    "commands": [
      {
        "command": "dendry.debug",
        "title": "Dendry: Build and Launch"
      }
    ],
    "keybindings": [
      {
        "command": "dendry.debug",
        "key": "f5",
        "when": "editorLangId == dendry && !inDebugMode"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run check-types && npm run package",
    "compile": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "package": "npm test && node esbuild.js --production",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "test:compat": "vitest run --config vitest.compat.config.ts",
    "test:watch": "vitest",
    "open-in-web": "vscode-test-web --quality=stable --extensionDevelopmentPath=. ."
  },
  "devDependencies": {
    "@types/node": "^16.0.0",
    "@types/vscode": "^1.80.0",
    "@vscode/test-web": "^0.0.80",
    "esbuild": "^0.28.0",
    "typescript": "^5.0.0",
    "vitest": "^4.1.8",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  },
  "dependencies": {
    "acorn": "^8.16.0"
  }
}
